{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "auro-tauri",
  "version": "0.1.0",
  "identifier": "org.aurodownloader.prototype",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AuroDownloader",
        "width": 760,
        "height": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
