{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuroDownloader",
  "version": "0.1.0",
  "identifier": "org.aurodownloader.desktop",
  "build": {
    "frontendDist": "../../ui/src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AuroDownloader",
        "width": 1120,
        "height": 680,
        "minWidth": 520,
        "minHeight": 380,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "publisher": "AuroDownloader",
    "category": "Utility",
    "shortDescription": "Gestionnaire de téléchargement libre",
    "longDescription": "Gestionnaire de téléchargement libre : téléchargements segmentés, reprise après coupure, files d'attente, limites de débit et plages horaires.",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
