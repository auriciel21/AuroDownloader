{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "0.1.0",
  "default_locale": "en",
  "key": "",
  "icons": {
    "32": "icons/32.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_icon": { "32": "icons/32.png", "64": "icons/64.png" },
    "default_title": "__MSG_name__",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["decide.js", "background.js"]
  },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "permissions": ["downloads", "nativeMessaging", "contextMenus", "storage", "cookies", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": { "id": "extension@aurodownloader.org", "strict_min_version": "128.0" }
  }
}
