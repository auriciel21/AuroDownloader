{
  "client": "page",
  "description": "La page de l'application (bureau et interface distante, ui/src) : requêtes telles qu'elle les compose.",
  "steps": [
    {"method": "engine.hello", "params": {"client": {"name": "auro-web", "version": "1.0"}, "protocol": {"min": "1.0", "max": "1.0"}}},
    {"method": "events.subscribe", "params": {"topics": ["tasks", "queues", "progress"], "progressIntervalMs": 1000}},
    {"method": "sync.snapshot", "params": {}},
    {"method": "settings.set", "params": {"values": {"downloads.dir": "${dir}"}}},
    {"method": "settings.set", "params": {"values": {"downloads.preallocate": true}}},
    {"method": "settings.set", "params": {"values": {"downloads.neighborChecksum": false}}},
    {"method": "settings.set", "params": {"values": {"logs.level": "debug"}}},
    {"method": "proxy.get", "params": {}},
    {"method": "proxy.set", "params": {"mode": "manual", "url": "http://127.0.0.1:3128", "exceptions": ["localhost"], "username": "moi", "password": "secret"}},
    {"method": "proxy.set", "params": {"mode": "manual", "url": "http://127.0.0.1:3128", "exceptions": ["localhost"], "username": "moi"}},
    {"method": "proxy.set", "params": {"mode": "system"}},
    {"method": "engine.diagnostic", "params": {}},
    {"method": "task.add", "params": {"sources": [{"url": "${url:/a.bin}"}], "startPaused": true}, "save": {"task": "/taskId"}},
    {"method": "task.add", "params": {"sources": [{"url": "${url:/b.bin}"}, {"url": "${url:/b-miroir.bin}"}], "startPaused": true, "checksum": {"algo": "sha256", "value": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}}},
    {"method": "task.add", "params": {"sources": [{"url": "${url:/c.bin}"}], "startPaused": true, "subDir": "ISO/Debian", "plugin": false}},
    {"method": "task.add", "params": {"sources": [{"torrent": "${torrent}"}], "startPaused": true}, "save": {"torrent": "/taskId"}},
    {"method": "task.get", "params": {"taskId": "${task}"}},
    {"method": "task.get", "params": {"taskId": "${task}", "include": ["sources"]}},
    {"method": "task.get", "params": {"taskId": "${task}", "include": ["segments", "sources"]}},
    {"method": "task.get", "params": {"taskId": "${torrent}", "include": ["sources", "files"]}},
    {"method": "task.add", "params": {"site": {"pageUrl": "${url:/page.html}", "depth": 2, "maxPages": 200, "exclude": "(?i)logout|signout|deconnexion|déconnexion|[?&;]C=[NMSD][;&]O=[AD]", "sameFolder": false, "ignoreRobots": false, "files": ["${url:/f.zip}"]}, "startPaused": true, "subDir": "Copies"}, "save": {"site": "/taskId"}},
    {"method": "task.get", "params": {"taskId": "${site}", "include": ["items"]}},
    {"method": "task.get", "params": {"taskId": "${site}", "include": []}},
    {"method": "task.setFiles", "params": {"taskId": "${torrent}", "selected": [0]}, "expect": ["INVALID_PARAMS"]},
    {"method": "task.update", "params": {"taskId": "${task}", "speedLimitBps": 500000}},
    {"method": "task.update", "params": {"taskId": "${task}", "speedLimitBps": null}},
    {"method": "task.update", "params": {"taskId": "${task}", "checksum": {"algo": "md5", "value": "d41d8cd98f00b204e9800998ecf8427e"}}},
    {"method": "task.update", "params": {"taskId": "${task}", "checksum": null}},
    {"method": "task.update", "params": {"taskId": "${task}", "url": "${url:/a-nouvelle.bin}"}},
    {"method": "task.update", "params": {"taskId": "${task}", "fileName": "renomme.bin"}},
    {"method": "task.addSource", "params": {"taskId": "${task}", "url": "${url:/a-miroir.bin}"}},
    {"method": "task.resume", "params": {"taskIds": ["${task}"]}},
    {"method": "task.pause", "params": {"taskIds": ["${task}"]}},
    {"method": "task.cancel", "params": {"taskIds": ["${task}"], "deleteFiles": true}},
    {"method": "task.restart", "params": {"taskIds": ["${task}"], "deleteFiles": true}, "expect": ["ok", "INVALID_STATE"]},
    {"method": "task.remove", "params": {"taskIds": ["${task}", "${torrent}"], "deleteFiles": true}},
    {"method": "schedule.set", "params": {"name": "Nuit", "enabled": true, "rules": {"windows": [{"days": [1, 2, 3, 4, 5], "start": "23:00", "end": "07:00"}], "onDone": "none"}}, "save": {"schedule": "/scheduleId"}},
    {"method": "queue.list", "params": {}, "save": {"queue": "/items/0/queueId"}},
    {"method": "queue.update", "params": {"queueId": "${queue}", "scheduleId": "${schedule}"}},
    {"method": "queue.update", "params": {"queueId": "${queue}", "scheduleId": null}},
    {"method": "engine.cancelEndAction", "params": {}},
    {"method": "limits.set", "params": {"downloadBps": 1000000}},
    {"method": "limits.set", "params": {"downloadBps": null}},
    {"method": "limits.set", "params": {"uploadBps": null}},
    {"method": "settings.set", "params": {"values": {"torrent.ratioLimit": 1.5}}},
    {"method": "settings.set", "params": {"values": {"torrent.interface": null}}},
    {"method": "torrent.interfaces", "params": {}},
    {"method": "metalink.read", "params": {"data": "${metalink}"}},
    {"method": "metalink.read", "params": {"url": "${url:/lot.meta4}"}},
    {"method": "metalink.add", "params": {"data": "${metalink}", "select": [0], "startPaused": true}},
    {"method": "linkscan.run", "params": {"pageUrl": "${url:/page.html}"}},
    {"method": "linkscan.run", "params": {"text": "${url:/d.bin} ${url:/e.zip}"}},
    {"method": "linkscan.probe", "params": {"urls": ["${url:/d.bin}"]}},
    {"method": "linkscan.crawl", "params": {"pageUrl": "${url:/page.html}", "depth": 1, "maxPages": 200, "exclude": "(?i)logout|signout|deconnexion|déconnexion|[?&;]C=[NMSD][;&]O=[AD]", "sameFolder": false, "ignoreRobots": false}, "save": {"crawl": "/crawlId"}},
    {"method": "linkscan.cancel", "params": {"crawlId": "${crawl}"}},
    {"method": "linkscan.crawlResult", "params": {"crawlId": "${crawl}"}},
    {"method": "task.addBatch", "params": {"items": [{"sources": [{"url": "${url:/d.bin}"}], "startPaused": true}, {"sources": [{"url": "${url:/e.zip}"}], "startPaused": true}]}},
    {"method": "media.tools", "params": {}},
    {"method": "media.probe", "params": {"pageUrl": "${url:/video.html}"}, "expect": ["TOOLS_MISSING", "EXTRACTOR_FAILED"]},
    {"method": "media.installTools", "params": {"force": false}, "replay": false},
    {"method": "task.add", "params": {"media": {"pageUrl": "${url:/video.html}", "format": "bv*+ba/b", "container": "mp4", "subtitles": ["fr"], "title": "Essai"}, "startPaused": true}, "expect": ["ok", "TOOLS_MISSING"]},
    {"method": "history.list", "params": {"limit": 50}},
    {"method": "history.list", "params": {"query": "a.bin", "limit": 50}},
    {"method": "history.clear", "params": {}},
    {"method": "login.list", "params": {}},
    {"method": "login.set", "params": {"site": "exemple.org", "username": "moi", "password": "secret"}, "save": {"login": "/loginId"}},
    {"method": "login.set", "params": {"loginId": "${login}", "site": "exemple.org", "username": "moi", "allowPlain": false}},
    {"method": "login.set", "params": {"site": "sftp://ssh.exemple.org", "username": "moi", "keyPath": "/inexistant/id_ed25519", "allowPlain": false}, "expect": ["INVALID_PARAMS"]},
    {"method": "hostkey.list", "params": {}},
    {"method": "hostkey.accept", "params": {"host": "ssh.exemple.org", "port": 22, "fingerprint": "SHA256:abc"}, "expect": ["INVALID_PARAMS"]},
    {"method": "hostkey.remove", "params": {"host": "ssh.exemple.org", "port": 22}},
    {"method": "login.delete", "params": {"loginId": "${login}"}},
    {"method": "plugin.list", "params": {}},
    {"method": "plugin.inspect", "params": {"data": "${plugin}"}},
    {"method": "plugin.install", "params": {"data": "${plugin}", "digest": "${pluginDigest}"}, "save": {"pluginId": "/pluginId"}},
    {"method": "plugin.enable", "params": {"pluginId": "${pluginId}", "enabled": false}},
    {"method": "plugin.enable", "params": {"pluginId": "${pluginId}", "enabled": true}},
    {"method": "plugin.match", "params": {"url": "https://fichiers.exemple/page"}},
    {"method": "plugin.resolve", "params": {"url": "https://fichiers.exemple/page"}, "save": {"resolution": "/resolutionId"}},
    {"method": "plugin.add", "params": {"resolutionId": "${resolution}", "links": [0], "startPaused": true}},
    {"method": "plugin.remove", "params": {"pluginId": "${pluginId}"}},
    {"method": "remote.status", "params": {}},
    {"method": "token.list", "params": {}},
    {"method": "token.create", "params": {"name": "Téléphone", "scope": "control"}, "save": {"token": "/id"}},
    {"method": "token.revoke", "params": {"tokenId": "${token}"}},
    {"method": "settings.set", "params": {"values": {"remote.hosts": ["nas.maison"]}}},
    {"method": "settings.set", "params": {"values": {"remote.tlsCert": null, "remote.tlsKey": null}}}
  ]
}
