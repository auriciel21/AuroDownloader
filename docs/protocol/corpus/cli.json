{
  "client": "cli",
  "description": "La ligne de commande (crates/cli) : requêtes telles qu'elle les compose.",
  "steps": [
    {"method": "engine.hello", "params": {"client": {"name": "auro", "version": "0.1.0"}, "protocol": {"min": "1.0", "max": "1.0"}}},
    {"method": "queue.list", "params": {}, "save": {"queue": "/items/0/queueId"}},
    {"method": "task.add", "params": {"sources": [{"url": "${url:/a.bin}"}, {"url": "${url:/a-miroir.bin}"}], "destDir": "${dir}", "startPaused": true, "maxConnections": 4, "speedLimitBps": 1000000, "checksum": {"algo": "sha256", "value": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}, "plugin": false, "queueId": "${queue}", "headers": {"Referer": "https://exemple.org/", "Cookie": "session=1"}}, "save": {"task": "/taskId"}},
    {"method": "task.add", "params": {"sources": [{"torrent": "${torrent}"}], "destDir": "${dir}", "startPaused": true}, "save": {"torrent": "/taskId"}},
    {"method": "task.add", "params": {"sources": [{"url": "ftp://moi:secret@ftp.exemple.org/pub/f.iso"}], "destDir": "${dir}", "startPaused": true}},
    {"method": "task.list", "params": {}},
    {"method": "task.list", "params": {"states": ["queued", "active", "paused"], "limit": 100}},
    {"method": "task.get", "params": {"taskId": "${task}"}},
    {"method": "task.get", "params": {"taskId": "${task}", "include": ["sources"]}},
    {"method": "task.get", "params": {"taskId": "${torrent}", "include": ["files"]}},
    {"method": "task.setFiles", "params": {"taskId": "${torrent}", "selected": [0, 1]}, "expect": ["INVALID_PARAMS"]},
    {"method": "task.update", "params": {"taskId": "${task}", "speedLimitBps": 200000}},
    {"method": "task.update", "params": {"taskId": "${task}", "checksum": null}},
    {"method": "task.update", "params": {"taskId": "${task}", "url": "${url:/a-nouvelle.bin}"}},
    {"method": "task.update", "params": {"taskId": "${task}", "destDir": "${dir}", "fileName": "deplace.bin"}},
    {"method": "task.addSource", "params": {"taskId": "${task}", "url": "${url:/a-autre.bin}"}},
    {"method": "task.resume", "params": {"taskIds": ["${task}"]}},
    {"method": "task.pause", "params": {"taskIds": ["${task}"]}},
    {"method": "task.cancel", "params": {"taskIds": ["${task}"], "deleteFiles": false}},
    {"method": "task.restart", "params": {"taskIds": ["${task}"], "deleteFiles": true}, "expect": ["ok", "INVALID_STATE"]},
    {"method": "task.remove", "params": {"taskIds": ["${task}", "${torrent}"], "deleteFiles": true}},
    {"method": "queue.create", "params": {"name": "Nuit", "maxActive": 2, "speedLimitBps": 500000}, "save": {"night": "/queueId"}},
    {"method": "queue.update", "params": {"queueId": "${night}", "name": "Nuit calme", "maxActive": 1, "speedLimitBps": null}},
    {"method": "schedule.set", "params": {"name": "Nuit", "rules": {"windows": [{"days": [1, 2, 3, 4, 5], "start": "23:00", "end": "07:00"}], "onDone": "sleep"}}, "save": {"schedule": "/scheduleId"}},
    {"method": "schedule.list", "params": {}},
    {"method": "queue.update", "params": {"queueId": "${night}", "scheduleId": "${schedule}"}},
    {"method": "queue.update", "params": {"queueId": "${night}", "scheduleId": null}},
    {"method": "schedule.delete", "params": {"scheduleId": "${schedule}"}},
    {"method": "engine.cancelEndAction", "params": {}},
    {"method": "sync.snapshot", "params": {}},
    {"method": "settings.get", "params": {}},
    {"method": "settings.set", "params": {"values": {"logs.level": "warn"}}},
    {"method": "engine.diagnostic", "params": {}},
    {"method": "proxy.get", "params": {}},
    {"method": "proxy.set", "params": {"mode": "manual", "url": "socks5://127.0.0.1:1080", "exceptions": ["localhost", ".lan"]}},
    {"method": "proxy.set", "params": {"mode": "manual", "url": "http://127.0.0.1:3128", "exceptions": [], "username": "moi", "password": "secret"}},
    {"method": "proxy.set", "params": {"mode": "none"}},
    {"method": "proxy.set", "params": {"mode": "system"}},
    {"method": "rules.list", "params": {}},
    {"method": "rules.set", "params": {"rules": [{"name": "Images", "enabled": true, "match": {"categories": ["images"], "extensions": ["iso"], "domains": ["exemple.org"], "urlRegex": null, "nameRegex": "(?i)^photo"}, "actions": {"folder": "Rangées/Images", "rename": "{date}-{nom}.{ext}", "command": null}}]}},
    {"method": "rules.set", "params": {"rules": [{"name": null, "match": {"urlRegex": "("}}]}, "expect": ["INVALID_PARAMS"]},
    {"method": "rules.set", "params": {"rules": []}},
    {"method": "settings.set", "params": {"values": {"torrent.ratioLimit": 2, "media.autoUpdate": false}}},
    {"method": "settings.set", "params": {"values": {"remote.enabled": false, "remote.listen": "127.0.0.1:7380"}}},
    {"method": "settings.set", "params": {"values": {"remote.hosts": null}}},
    {"method": "limits.get", "params": {}},
    {"method": "limits.set", "params": {"downloadBps": 1000000}},
    {"method": "limits.set", "params": {"uploadBps": 500000}},
    {"method": "metalink.read", "params": {"data": "${metalink}"}},
    {"method": "metalink.add", "params": {"data": "${metalink}", "select": [0], "destDir": "${dir}", "startPaused": true}},
    {"method": "linkscan.run", "params": {"pageUrl": "${url:/page.html}"}},
    {"method": "linkscan.probe", "params": {"urls": ["${url:/d.bin}", "${url:/e.zip}"]}},
    {"method": "task.addBatch", "params": {"items": [{"sources": [{"url": "${url:/d.bin}"}], "destDir": "${dir}", "startPaused": true}]}},
    {"method": "history.list", "params": {"query": "a", "limit": 20}},
    {"method": "history.clear", "params": {}},
    {"method": "login.list", "params": {}},
    {"method": "login.set", "params": {"site": "exemple.org", "username": "moi", "password": "secret"}, "save": {"login": "/loginId"}},
    {"method": "login.set", "params": {"loginId": "${login}", "site": "exemple.org", "username": "moi", "allowPlain": true}},
    {"method": "login.delete", "params": {"loginId": "${login}"}},
    {"method": "token.create", "params": {"name": "nas", "scope": "read"}, "save": {"token": "/id"}},
    {"method": "token.list", "params": {}},
    {"method": "token.revoke", "params": {"tokenId": "${token}"}},
    {"method": "remote.status", "params": {}},
    {"method": "plugin.inspect", "params": {"data": "${plugin}"}},
    {"method": "plugin.install", "params": {"data": "${plugin}", "digest": "${pluginDigest}"}, "save": {"pluginId": "/pluginId"}},
    {"method": "plugin.list", "params": {}},
    {"method": "plugin.enable", "params": {"pluginId": "${pluginId}", "enabled": true}},
    {"method": "plugin.resolve", "params": {"url": "https://fichiers.exemple/page"}, "save": {"resolution": "/resolutionId"}},
    {"method": "plugin.add", "params": {"resolutionId": "${resolution}", "links": [0], "destDir": "${dir}", "startPaused": true}},
    {"method": "plugin.remove", "params": {"pluginId": "${pluginId}"}},
    {"method": "media.tools", "params": {}},
    {"method": "events.subscribe", "params": {"topics": ["queues"]}},
    {"method": "media.installTools", "params": {"force": true}, "replay": false},
    {"method": "media.probe", "params": {"pageUrl": "${url:/video.html}"}, "expect": ["TOOLS_MISSING", "EXTRACTOR_FAILED"]},
    {"method": "engine.shutdown", "params": {"graceful": true}}
  ]
}
