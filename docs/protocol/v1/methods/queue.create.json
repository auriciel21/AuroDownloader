{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurodownloader.org/protocol/methods/queue.create.json",
  "title": "queue.create",
  "description": "Crée une file.",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "maxActive": {
          "type": "integer",
          "minimum": 0
        },
        "speedLimitBps": {
          "$ref": "https://aurodownloader.org/protocol/common.json#/$defs/limitParam"
        },
        "scheduleId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "result": {
      "$ref": "https://aurodownloader.org/protocol/common.json#/$defs/queue"
    }
  }
}
