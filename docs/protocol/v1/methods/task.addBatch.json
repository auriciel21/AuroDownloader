{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurodownloader.org/protocol/methods/task.addBatch.json",
  "title": "task.addBatch",
  "description": "Ajoute plusieurs téléchargements, chacun ajouté ou refusé pour lui-même.",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "https://aurodownloader.org/protocol/common.json#/$defs/addParams"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "items"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "https://aurodownloader.org/protocol/common.json#/$defs/indexTask"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "https://aurodownloader.org/protocol/common.json#/$defs/indexError"
          }
        }
      },
      "required": [
        "tasks",
        "errors"
      ]
    }
  }
}
