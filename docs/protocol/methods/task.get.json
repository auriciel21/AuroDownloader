{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurodownloader.org/protocol/methods/task.get.json",
  "title": "task.get",
  "description": "Une tâche, et sur demande ses segments, ses sources et ses fichiers.",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string"
        },
        "include": {
          "type": "array",
          "items": {
            "enum": [
              "segments",
              "sources",
              "files",
              "items"
            ]
          }
        }
      },
      "required": [
        "taskId"
      ]
    },
    "result": {
      "allOf": [
        {
          "$ref": "https://aurodownloader.org/protocol/common.json#/$defs/task"
        }
      ],
      "type": "object",
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "idx": {
                "type": "integer"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              },
              "doneBytes": {
                "type": "integer",
                "minimum": 0
              },
              "receiving": {
                "type": "boolean"
              },
              "sourceId": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "idx",
              "start",
              "end",
              "doneBytes",
              "receiving"
            ]
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "acceptsRanges": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "rank": {
                "type": "integer"
              },
              "state": {
                "enum": [
                  "unknown",
                  "ok",
                  "slow",
                  "failed"
                ]
              },
              "avgBps": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "failCount": {
                "type": "integer",
                "minimum": 0
              },
              "lastError": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "badPieces": {
                "description": "Morceaux faux envoyés (F-12) ; depuis le 2026-11-17.",
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "sourceId",
              "url",
              "acceptsRanges",
              "rank",
              "state",
              "avgBps",
              "failCount",
              "lastError"
            ]
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "path": {
                "type": "string"
              },
              "length": {
                "type": "integer",
                "minimum": 0
              },
              "selected": {
                "type": "boolean"
              },
              "doneBytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "index",
              "path",
              "length",
              "selected",
              "doneBytes"
            ]
          }
        },
        "pieces": {
          "description": "Empreintes de morceaux d'un Metalink (F-12) ; depuis le 2026-11-17.",
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "length": {
              "type": "integer",
              "minimum": 1
            },
            "algo": {
              "enum": [
                "sha256",
                "sha1",
                "md5"
              ]
            },
            "redone": {
              "type": "integer",
              "minimum": 0
            },
            "rounds": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "count",
            "length",
            "algo",
            "redone",
            "rounds"
          ]
        },
        "plugin": {
          "type": "object",
          "properties": {
            "page": {
              "type": "string"
            },
            "pluginId": {
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "page",
            "pluginId",
            "name"
          ]
        },
        "site": {
          "description": "Copie d'un site (SPEC 7.18 ter) ; depuis le 2026-11-26.",
          "type": "object",
          "properties": {
            "pageUrl": {
              "type": "string"
            },
            "startPath": {
              "description": "Page de départ copiée, relative au dossier de la tâche ; null avant sa lecture.",
              "type": [
                "string",
                "null"
              ]
            },
            "depth": {
              "type": "integer",
              "minimum": 1
            },
            "maxPages": {
              "type": "integer",
              "minimum": 1
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1
            },
            "exclude": {
              "type": [
                "string",
                "null"
              ]
            },
            "sameFolder": {
              "type": "boolean"
            },
            "ignoreRobots": {
              "type": "boolean"
            },
            "stop": {
              "description": "Raison de la fin de l'exploration ; null tant qu'elle continue.",
              "enum": [
                "finished",
                "maxPages",
                "maxBytes",
                "maxItems",
                null
              ]
            },
            "pages": {
              "type": "integer",
              "minimum": 0
            },
            "resources": {
              "type": "integer",
              "minimum": 0
            },
            "files": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            },
            "queued": {
              "type": "integer",
              "minimum": 0
            },
            "items": {
              "description": "Avec include: [\"items\"].",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "page",
                      "style",
                      "resource",
                      "file"
                    ]
                  },
                  "state": {
                    "enum": [
                      "queued",
                      "fetched",
                      "done",
                      "failed",
                      "skipped"
                    ]
                  },
                  "path": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "size": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "error": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "url",
                  "kind",
                  "state",
                  "path",
                  "size",
                  "error"
                ]
              }
            }
          },
          "required": [
            "pageUrl",
            "startPath",
            "depth",
            "maxPages",
            "maxBytes",
            "exclude",
            "sameFolder",
            "ignoreRobots",
            "stop",
            "pages",
            "resources",
            "files",
            "failed",
            "skipped",
            "queued"
          ]
        }
      }
    }
  }
}
