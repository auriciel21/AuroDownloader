{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurodownloader.org/protocol/methods/task.get.json",
  "title": "task.get",
  "description": "Une tâche, et sur demande ses segments, ses sources et ses fichiers.",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string"
        },
        "include": {
          "type": "array",
          "items": {
            "enum": [
              "segments",
              "sources",
              "files"
            ]
          }
        }
      },
      "required": [
        "taskId"
      ]
    },
    "result": {
      "allOf": [
        {
          "$ref": "https://aurodownloader.org/protocol/common.json#/$defs/task"
        }
      ],
      "type": "object",
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "idx": {
                "type": "integer"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              },
              "doneBytes": {
                "type": "integer",
                "minimum": 0
              },
              "receiving": {
                "type": "boolean"
              },
              "sourceId": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "idx",
              "start",
              "end",
              "doneBytes",
              "receiving"
            ]
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "acceptsRanges": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "rank": {
                "type": "integer"
              },
              "state": {
                "enum": [
                  "unknown",
                  "ok",
                  "slow",
                  "failed"
                ]
              },
              "avgBps": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "failCount": {
                "type": "integer",
                "minimum": 0
              },
              "lastError": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "badPieces": {
                "description": "Morceaux faux envoyés (F-12) ; depuis le 2026-11-17.",
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "sourceId",
              "url",
              "acceptsRanges",
              "rank",
              "state",
              "avgBps",
              "failCount",
              "lastError"
            ]
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "path": {
                "type": "string"
              },
              "length": {
                "type": "integer",
                "minimum": 0
              },
              "selected": {
                "type": "boolean"
              },
              "doneBytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "index",
              "path",
              "length",
              "selected",
              "doneBytes"
            ]
          }
        },
        "pieces": {
          "description": "Empreintes de morceaux d'un Metalink (F-12) ; depuis le 2026-11-17.",
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "length": {
              "type": "integer",
              "minimum": 1
            },
            "algo": {
              "enum": [
                "sha256",
                "sha1",
                "md5"
              ]
            },
            "redone": {
              "type": "integer",
              "minimum": 0
            },
            "rounds": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "count",
            "length",
            "algo",
            "redone",
            "rounds"
          ]
        },
        "plugin": {
          "type": "object",
          "properties": {
            "page": {
              "type": "string"
            },
            "pluginId": {
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "page",
            "pluginId",
            "name"
          ]
        }
      }
    }
  }
}
