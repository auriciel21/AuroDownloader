{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurodownloader.org/protocol/methods/hostkey.remove.json",
  "title": "hostkey.remove",
  "description": "Oublie la clé acceptée d'un serveur SSH : la prochaine connexion la montrera de nouveau.",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "host",
        "port"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "boolean"
        }
      },
      "required": [
        "removed"
      ]
    }
  }
}
