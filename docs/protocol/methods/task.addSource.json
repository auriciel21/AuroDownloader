{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurodownloader.org/protocol/methods/task.addSource.json",
  "title": "task.addSource",
  "description": "Ajoute un miroir à une tâche HTTP (SPEC 7.7).",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "taskId",
        "url"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string"
        }
      },
      "required": [
        "sourceId"
      ]
    }
  }
}
