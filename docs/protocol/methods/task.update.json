{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurodownloader.org/protocol/methods/task.update.json",
  "title": "task.update",
  "description": "Change la limite, l'empreinte, l'adresse, ou le dossier et le nom d'une tâche (un à la fois).",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string"
        },
        "speedLimitBps": {
          "$ref": "https://aurodownloader.org/protocol/common.json#/$defs/limitParam"
        },
        "checksum": {
          "$ref": "https://aurodownloader.org/protocol/common.json#/$defs/checksumParam"
        },
        "ratioLimit": {
          "description": "Ratio de partage d'un torrent (SPEC 7.16), ou null pour celui du réglage torrent.ratioLimit (depuis le 2026-11-24).",
          "type": ["number", "null"],
          "minimum": 0
        },
        "url": {
          "type": "string"
        },
        "destDir": {
          "type": "string"
        },
        "fileName": {
          "type": "string"
        }
      },
      "required": [
        "taskId"
      ]
    },
    "result": {
      "$ref": "https://aurodownloader.org/protocol/common.json#/$defs/task"
    }
  }
}
