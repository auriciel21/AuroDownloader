{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurodownloader.org/protocol/methods/plugin.match.json",
  "title": "plugin.match",
  "description": "Le plugin activé qui prend en charge une page.",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "plugin": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "pluginId": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "pluginId",
                "name"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "plugin"
      ]
    }
  }
}
