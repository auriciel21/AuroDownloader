{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurodownloader.org/protocol/notifications/task.updated.json",
  "title": "task.updated",
  "description": "Champs d'une tâche qui ont changé, seulement eux.",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "rev": {
          "$ref": "https://aurodownloader.org/protocol/common.json#/$defs/rev"
        },
        "taskId": {
          "type": "string"
        },
        "speedLimitBps": {
          "$ref": "https://aurodownloader.org/protocol/common.json#/$defs/limit"
        },
        "checksum": {
          "$ref": "https://aurodownloader.org/protocol/common.json#/$defs/checksum"
        },
        "ratioLimit": {
          "description": "Ratio de partage d'un torrent (SPEC 7.16), ou null pour celui du réglage torrent.ratioLimit (depuis le 2026-11-24).",
          "type": ["number", "null"],
          "minimum": 0
        },
        "fileName": {
          "type": [
            "string",
            "null"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "totalBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "doneBytes": {
          "type": "integer",
          "minimum": 0
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "errorDetail": {
          "type": [
            "string",
            "null"
          ]
        },
        "destDir": {
          "type": "string"
        },
        "moving": {
          "type": "boolean"
        },
        "moveError": {
          "type": "string"
        }
      },
      "required": [
        "rev",
        "taskId"
      ]
    }
  }
}
