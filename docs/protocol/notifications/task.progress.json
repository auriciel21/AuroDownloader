{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurodownloader.org/protocol/notifications/task.progress.json",
  "title": "task.progress",
  "description": "Avancement groupé ; peut être sauté par un client lent.",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "rev": {
          "$ref": "https://aurodownloader.org/protocol/common.json#/$defs/rev"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taskId": {
                "type": "string"
              },
              "doneBytes": {
                "type": "integer",
                "minimum": 0
              },
              "totalBytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "bps": {
                "type": "integer",
                "minimum": 0
              },
              "connections": {
                "type": "integer",
                "minimum": 0
              },
              "etaS": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "verifiedBytes": {
                "type": "integer",
                "minimum": 0
              },
              "uploadedBytes": {
                "type": "integer",
                "minimum": 0
              },
              "uploadBps": {
                "type": "integer",
                "minimum": 0
              },
              "site": {
                "description": "Copie d'un site (SPEC 7.18 ter) : ses éléments ; depuis le 2026-11-26.",
                "type": "object",
                "properties": {
                  "pages": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "resources": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "files": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "online": {
                    "description": "Liens laissés en ligne parce qu'ils ne mènent pas à une page web (éléments en échec NOT_HTML), comptés hors de failed ; depuis le 2026-11-27.",
                    "type": "integer",
                    "minimum": 0
                  },
                  "queued": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "pages",
                  "resources",
                  "files",
                  "failed",
                  "queued"
                ]
              }
            },
            "required": [
              "taskId",
              "doneBytes",
              "totalBytes",
              "bps",
              "connections",
              "etaS"
            ]
          }
        }
      },
      "required": [
        "rev",
        "items"
      ]
    }
  }
}
